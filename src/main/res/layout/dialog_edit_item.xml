<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/blue_dialog_bg">

    <EditText
        android:id="@+id/etEditName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Item Name"
        android:textColor="@color/navy_text_primary"
        android:textColorHint="@color/navy_text_secondary"/>

    <EditText
        android:id="@+id/etEditCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Category"
        android:textColor="@color/navy_text_primary"
        android:textColorHint="@color/navy_text_secondary"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/etEditQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="Quantity"
        android:textColor="@color/navy_text_primary"
        android:textColorHint="@color/navy_text_secondary"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/etEditExpected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="Expected Target Quantity"
        android:textColor="@color/navy_text_primary"
        android:textColorHint="@color/navy_text_secondary"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/etEditSku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="SKU Code (auto-assigned if blank)"
        android:textColor="@color/navy_text_primary"
        android:textColorHint="@color/navy_text_secondary"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/etEditBarcode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Barcode (auto-assigned if blank)"
        android:textColor="@color/navy_text_primary"
        android:textColorHint="@color/navy_text_secondary"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/etEditCostPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Cost Price (R)"
        android:textColor="@color/navy_text_primary"
        android:textColorHint="@color/navy_text_secondary"
        android:layout_marginTop="12dp"/>
</LinearLayout>
